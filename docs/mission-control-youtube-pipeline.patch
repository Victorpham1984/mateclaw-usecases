+      : score >= 0.5
+      ? "text-yellow-400 bg-yellow-900/20"
+      : "text-red-400 bg-red-900/20";
+  return (
+    <span className={`text-xs px-2 py-0.5 rounded-full ${color}`}>
+      {Math.round(score * 100)}% confidence
+    </span>
+  );
+}

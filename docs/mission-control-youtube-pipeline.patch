+          </p>
+        </Link>
+
+        <Link
+          href="/admin/categories"
+          className="p-5 rounded-xl bg-[#12121f] border border-[#1e1e30] hover:border-green-500/30 transition group"
+        >
+          <div className="flex items-center gap-3 mb-2">
